// JOCKY investigation program grammar.
//
// A program states investigation INTENT: which case, which endpoints, what to
// collect, how to correlate it and what to report. It deliberately has no way
// to express an arbitrary command, a path to execute, or anything a platform
// adapter could turn into a shell. Everything here compiles to a bounded,
// read-only collection plan.
//
// Statements are newline-terminated. Without that, a bare word argument would
// happily swallow the keyword starting the next statement.

program: _NL* (statement _NL*)+

?statement: case_stmt
          | target_stmt
          | window_stmt
          | let_stmt
          | collect_stmt
          | filter_stmt
          | correlate_stmt
          | timeline_stmt
          | report_stmt

case_stmt: "CASE"i STRING case_block?
case_block: "{" _NL* (case_field _NL*)+ "}"
case_field: CASE_KEY STRING
CASE_KEY: "TITLE"i | "EXAMINER"i | "REFERENCE"i | "NOTES"i

target_stmt: "TARGET"i STRING platform_clause?
platform_clause: "PLATFORM"i PLATFORM
PLATFORM.2: "linux"i | "windows"i | "any"i

window_stmt: "WINDOW"i "LAST"i NUMBER UNIT
UNIT.2: "HOURS"i | "DAYS"i

let_stmt: "LET"i NAME "=" value

collect_stmt: "COLLECT"i SOURCE collect_arg* collect_option*
SOURCE.3: "SYSTEM"i | "PROCESSES"i | "EXECUTION"i | "NETWORK"i | "BROWSER"i
        | "USB"i | "DRIVERS"i | "FILES"i | "MEMORY"i | "SERVICES"i | "LOGS"i
collect_arg: value
collect_option: OPTION_KEY value
OPTION_KEY.3: "LIMIT"i | "FROM"i | "DEPTH"i

filter_stmt: "FILTER"i FIELD OPERATOR value
FIELD.3: "PATH"i | "COMMAND"i | "USER"i | "HOST"i | "SOURCE"i | "HASH"i
OPERATOR.3: "CONTAINS"i | "EQUALS"i | "MATCHES"i | "STARTS"i

correlate_stmt: "CORRELATE"i SUBJECT "WITH"i SUBJECT
SUBJECT.3: "ARTIFACTS"i | "EXECUTION"i | "BROWSER"i | "USB"i | "NETWORK"i
         | "MEMORY"i | "DRIVERS"i

timeline_stmt: "TIMELINE"i TIMELINE_KIND timeline_option*
TIMELINE_KIND.3: "SIGNIFICANT"i | "FULL"i
timeline_option: "LIMIT"i NUMBER

report_stmt: "REPORT"i REPORT_KIND
REPORT_KIND.3: "SUMMARY"i | "EVIDENCE"i | "BOTH"i

?value: STRING -> string_value
      | NUMBER -> number_value
      | VARIABLE -> variable_value
      | NAME -> name_value

VARIABLE: /\$[A-Za-z_][A-Za-z0-9_]*/
NAME: /[A-Za-z_][A-Za-z0-9_.\/-]*/
STRING: /"[^"\r\n]*"/
NUMBER: /[0-9]+/

_NL: /(\r?\n)+/
COMMENT: /#[^\r\n]*/
%ignore COMMENT
WS_INLINE: /[ \t]+/
%ignore WS_INLINE
