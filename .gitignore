# Python runtime and virtual environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Build trees and frozen output. backend-dist holds the PyInstaller engine,
# which is rebuilt per platform and must never be committed.
**/build/
backend-dist/
**/.dart_tool/
**/ephemeral/
**/node_modules/
**/dist/
.flutter-plugins-dependencies

# Release artifacts. These are produced by packaging/ and published by CI.
*.deb
*.msi
*.AppImage

# Operator data: investigations, evidence and reports never belong in git.
data/hash_ledger.json*
*.db
*.db-*
*.sqlite*
workspace.lock
local-workspace/
output/
reports/*.pdf
reports/*.json
*.log
*.tmp

# Reference material kept beside the project, not part of it.
reference-repo/
referencereppos/
# docs/ was ignored as working material. The documentation set is now part of
# the deliverable, so it is tracked. A re-include under an ignored directory
# does not work -- git never descends into one -- so the rule is gone entirely.

# Editor and OS metadata
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
